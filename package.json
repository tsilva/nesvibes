{
  "name": "nesvibes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "preinstall": "node -e \"const ua = process.env.npm_config_user_agent || ''; if (!ua.startsWith('pnpm/')) { console.error('Use pnpm for this repo.'); process.exit(1); }\"",
    "dev": "node scripts/dev-server.mjs vite dev",
    "build": "vite build && node scripts/rom-assets.mjs --check-build",
    "preview": "node scripts/dev-server.mjs vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "check:headers": "node scripts/check-security-headers.mjs",
    "check:rom-assets": "node scripts/rom-assets.mjs",
    "prune:rom-assets": "node scripts/rom-assets.mjs --prune",
    "test:emu": "node --test"
  },
  "dependencies": {
    "@fontsource/silkscreen": "^5.3.0",
    "@sentry/sveltekit": "11.12.0",
    "@vercel/analytics": "2.0.1",
    "lucide-svelte": "^1.0.1",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@sveltejs/adapter-vercel": "7.0.3",
    "@sveltejs/kit": "3.2.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "playwright": "^1.65.1",
    "svelte-check": "4.7.8",
    "vite": "8.3.8",
    "typescript": "6.0.3"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
