{
  "name": "nesvibes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "preinstall": "node -e \"const ua = process.env.npm_config_user_agent || ''; if (!ua.startsWith('pnpm/')) { console.error('Use pnpm for this repo.'); process.exit(1); }\"",
    "dev": "node scripts/dev-server.mjs vite dev",
    "build": "vite build",
    "preview": "node scripts/dev-server.mjs vite preview",
    "sentry:issues": "node scripts/sentry-issues.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "check:headers": "node scripts/check-security-headers.mjs",
    "check:rom-assets": "node scripts/rom-assets.mjs",
    "prune:rom-assets": "node scripts/rom-assets.mjs --prune",
    "test:emu": "node --test"
  },
  "dependencies": {
    "@fontsource/silkscreen": "^5.3.0",
    "@sentry/sveltekit": "^10.69.0",
    "@vercel/analytics": "1.6.1",
    "lucide-svelte": "^0.577.0",
    "svelte": "5.56.8"
  },
  "devDependencies": {
    "@sveltejs/adapter-vercel": "6.3.4",
    "@sveltejs/kit": "2.70.2",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "playwright": "^1.62.1",
    "svelte-check": "4.7.5",
    "vite": "8.2.1"
  }
}
