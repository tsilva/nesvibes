{
  "name": "nesvibes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "preinstall": "node -e \"const ua = process.env.npm_config_user_agent || ''; if (!ua.startsWith('pnpm/')) { console.error('Use pnpm for this repo.'); process.exit(1); }\"",
    "dev": "python3 scripts/infisical/run.py dev",
    "build": "vite build",
    "preview": "node scripts/dev-server.mjs vite preview",
    "sentry:issues": "python3 scripts/infisical/run.py issues",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "check:headers": "node scripts/check-security-headers.mjs",
    "check:rom-assets": "node scripts/rom-assets.mjs",
    "prune:rom-assets": "node scripts/rom-assets.mjs --prune",
    "test:emu": "node --test",
    "dev:app": "node scripts/dev-server.mjs vite dev",
    "build:secrets": "python3 scripts/infisical/run.py build",
    "secrets:check": "python3 scripts/infisical/run.py check",
    "secrets:migrate:keyenv": "python3 scripts/infisical/migrate_keyenv.py",
    "test:secrets": "python3 -m unittest discover -s scripts/infisical -p test_secrets.py",
    "secrets:sync:production": "python3 scripts/infisical/sync_production.py"
  },
  "dependencies": {
    "@fontsource/silkscreen": "^5.3.0",
    "@sentry/sveltekit": "^10.73.0",
    "@vercel/analytics": "1.6.1",
    "lucide-svelte": "^1.0.1",
    "svelte": "5.56.8"
  },
  "devDependencies": {
    "@sveltejs/adapter-vercel": "6.3.4",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "playwright": "^1.63.0",
    "svelte-check": "4.7.6",
    "vite": "8.2.2"
  }
}
